{
    "name": "lion/command",
    "description": "library created with the function of executing commands from PHP.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lion\\Command\\": "src/LionCommand/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.11 || ^4.0",
        "phpunit/phpunit": "^12.0",
        "vlucas/phpdotenv": "^5.6",
        "symfony/console": "^8.0",
        "overtrue/phplint": "^9.7",
        "lion/test": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
